{
  "name": "fusion-schema-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP MCP server grounding a Fusion-SQL agent against the Oracle Fusion schema catalog (real objects + real relations).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "compile": "node dist/compile.js",
    "compile:dev": "tsx src/compile.ts",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "smoke": "node dist/smoke.js",
    "smoke:dev": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.8.0",
    "csv-parse": "^5.5.6",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
