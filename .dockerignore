# SHIP-SAFETY + build-context size: the whole data/ tree (META_*.csv ~250MB, mined relationships,
# the ~1.1GB Oracle-catalog-extracted SQL corpus enrich.sqlite, jsonl runs) stays out. Nothing in
# the image reads it: the catalog is served from Postgres (or a sqlite seed VOLUME), never compiled
# at build time.
data
_gem_compare.json
**/*_gem_compare.json

# dev-only: the SQLite -> Postgres catalog importer (D13) never ships in the image. Its ddl.sql is
# the ONE source of the Postgres shape, so the BUILD stage keeps it for the contract suite's
# throwaway database (test/fixture.ts); the runtime stage copies only dist/ + node_modules.
scripts/pg-import/*
!scripts/pg-import/ddl.sql

# dev-box-only: the raw landing-zone loader for the fusion_dev database. Nothing in the image reads
# it and no serving code depends on its shape, so the whole directory stays out of the build.
scripts/fusion-dev
scripts/pipeline
