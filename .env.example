# fusion-schema-mcp — environment template. Copy to `.env` (gitignored) and fill in values.
# Loaded by the devops compose (env_file) into the schema-mcp container and read by the
# corpus enrichment tooling (src/corpus/*, scripts/gpu-enrich/*). NEVER commit real values.
#
# Seed data prerequisite: the CSVs/JSON in `data/` (META_*.csv, mined_relationships.json,
# otbi_relations.json) are gitignored. Restore them from the Tier B dataset BEFORE
# `docker compose build` (the Dockerfile compiles the seed DBs from them):
#   devops/scripts/tier-b.ps1 -Fetch -Dataset schema-mcp-data

# Anthropic API key (sk-ant-api...) — enrichment when ENRICH_PROVIDER=anthropic and for the
# Anthropic Batch API path (enrichBatchApi); used when ENRICH_API_KEY is not set.
ANTHROPIC_API_KEY=

# Google AI Studio key (AIza...) — Gemini enrichment (ENRICH_PROVIDER=gemini, native batch)
# and the ingest-side Gemini calls in src/ingest.ts.
GOOGLE_STUDIO_API_KEY=

# Enrichment LLM provider: gemini | anthropic | openai | agent | custom (see docs/ENRICHMENT-RUNBOOK.md).
ENRICH_PROVIDER=

# Model id override for the enrichment provider (provider default used when empty).
ENRICH_MODEL=

# Self-hosted vLLM endpoint base URL (HF Inference Endpoint) for scripts/gpu-enrich — not secret.
HF_ENDPOINT_URL=

# Hugging Face token (hf_...) — Bearer auth for HF_ENDPOINT_URL. Secret.
HF_TOKEN=

# vLLM data-parallel size for the remote endpoint run; shipped with the enrich run dir by
# scripts/gpu-enrich/vultr_push.sh (setup.sh/run_waves.sh read it as DP).
HF_DP=

# vLLM --max-num-seqs of the endpoint; the gpu-enrich client sizes its concurrency from it (must match).
MAX_NUM_SEQS=
